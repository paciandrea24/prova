# Dipendenze (non vanno mai nel repo)
node_modules/

# Variabili d'ambiente / segreti
.env
*.env

# graphify knowledge graph (rigenerabile con `graphify`)
graphify-out/

# Worktree git di lavoro (non fanno parte del repo)
.claude/worktrees/

# Cache plugin (superpowers)
.superpowers/

# Telemetria generata da f1LapSimulator (output, non sorgente)
backend/tools/*-telemetry.json

# Segnalazioni raccolte in gioco col tasto M (materiale di lavoro, non sorgente)
backend/tools/f1-segnalazioni.json

# Output della pipeline scultura-per-silhouette del modello auto F1
# (rigenerabile con f1CarVoxelize.py + f1CarBuilder.py, vedi
# docs/superpowers/plans/2026-07-24-f1-auto-custom-cockpit.md)
backend/tools/f1CarVoxelData.json
backend/tools/renders/

# Bytecode Python (generato importando backend/tools/circuitAssets)
__pycache__/
*.pyc

# disegni diagnostici del muro (rigenerabili con f1-barriera-dallalto.js)
backend/tools/out/
